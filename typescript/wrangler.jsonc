{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuaca",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "services": [
    {
      "binding": "WILAYAH",
      "service": "api"
    }
  ]
}
